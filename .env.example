# Copy this file to .env and fill in real values. Never commit .env.
# Placeholder values only.

# Required. Long random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value

# Optional. Defaults to a SQLite file under instance/.
# DATABASE_URL=sqlite:///instance/tasks.db

# Optional. Set to true only when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false
